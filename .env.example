# ==============================================================================
# SPORT-VIVO: Configuración de Entorno
# ==============================================================================
# Copia este archivo a .env y completa con tus credenciales:
#   cp .env.example .env
# ==============================================================================

# --- Configuración de Red y Host ---
# Puerto expuesto en el host para Dispatcharr Web UI y streaming
DISPATCHARR_PORT=9191

# IP local de tu máquina en la red local (para generar URLs para TiviMate)
HOST_IP="192.168.1.50"

# Red externa de Docker donde corre Jellyfin (por ejemplo: media-net)
DOCKER_NETWORK="media-net"

# Nivel de log de Dispatcharr (info, debug, warning, error)
DISPATCHARR_LOG_LEVEL="info"

# Directorio de persistencia de datos y base de datos
DISPATCHARR_DATA_DIR="./data"


# --- Credenciales Administrador (Dispatcharr Web UI) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="TuPasswordAdminSeguro123*"


# --- Credenciales Cliente IPTV (Para TiviMate, Smart TV, Jellyfin) ---
CLIENT_USERNAME="tv_living"
CLIENT_PASSWORD="TuPasswordCliente123*"


# --- Proveedor IPTV 1: Principal (Xtream Codes) ---
PROVIDER_NAME="Eagle 4K - Deportes AR"
PROVIDER_SELLER="X1STORE (z2u)"
PROVIDER_SERVER_URL="http://tu-servidor-iptv.com"
PROVIDER_USERNAME="tu_usuario_iptv"
PROVIDER_PASSWORD="tu_password_iptv"
PROVIDER_MAX_STREAMS=1

# --- Proveedor IPTV 2: Backup / Failover (Opcional) ---
BACKUP_PROVIDER_NAME="Trex OTT - Deportes AR"
BACKUP_PROVIDER_SELLER="Tienda Azza (z2u)"
BACKUP_PROVIDER_SERVER_URL="http://tu-servidor-backup.com"
BACKUP_PROVIDER_USERNAME="tu_usuario_backup"
BACKUP_PROVIDER_PASSWORD="tu_password_backup"
BACKUP_PROVIDER_MAX_STREAMS=1


# --- Guía Electrónica de Programación (EPG) ---
EPG_NAME="EPG Argentina"
EPG_URL="https://jarap.github.io/iptv-epg-argentina/epg.xml.gz"
